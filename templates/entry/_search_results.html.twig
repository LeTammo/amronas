<turbo-frame id="search-results">
    {% if matches is not empty %}
        <h3 class="s-head">{{ 'search.on_list'|trans }}</h3>
        {% for entry in matches %}
            {% set title = entry.title %}
            {# Shows the entry without filters, so it is sure to be there #}
            <a class="s-item" href="{{ path('app_list_show', {id: list.id, f: 1}) }}#entry-{{ entry.id }}" data-turbo-frame="_top" data-action="search#jump">
                {% if title.posterUrl %}<img src="{{ title.posterUrl|poster(80) }}" alt="" loading="lazy">{% else %}<span class="no-poster"></span>{% endif %}
                <span>
                    <span class="s-title">{{ title.name }}</span><br>
                    <span class="s-sub">
                        {{- ('filter.' ~ (title.series ? 'series_one' : 'movie_one'))|trans }}{% if title.year %} · {{ title.year }}{% endif %}
                        {%- if entry.watched %} · {{ 'search.watched'|trans }}{% endif -%}
                    </span>
                </span>
                <span class="s-act">{{ 'search.show'|trans }}</span>
            </a>
        {% endfor %}
    {% endif %}

    {% if is_granted('LIST_EDIT', list) %}
        <h3 class="s-head">{{ 'search.add_new'|trans }}</h3>
        {% for result in results %}
            <form method="post" action="{{ path('app_entry_add', {id: list.id}) }}" data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('entry') }}">
                <input type="hidden" name="q" value="{{ query }}">
                <input type="hidden" name="imdbId" value="{{ result.imdbId }}">
                <button class="s-item">
                    {% if result.posterUrl %}<img src="{{ result.posterUrl|poster(80) }}" alt="" loading="lazy">{% else %}<span class="no-poster"></span>{% endif %}
                    <span>
                        <span class="s-title">{{ result.name }}</span><br>
                        <span class="s-sub">
                            {{- ('filter.' ~ (result.type.value == 'movie' ? 'movie_one' : 'series_one'))|trans }}{% if result.year %} · {{ result.year }}{% endif %}
                            {%- if result.cast %} · {{ result.cast }}{% endif -%}
                        </span>
                    </span>
                    <span class="s-act">{{ ux_icon('tabler:plus') }}{{ 'search.add'|trans }}</span>
                </button>
            </form>
        {% else %}
            <div class="s-empty">{{ 'search.no_more'|trans({'%query%': query}) }}</div>
        {% endfor %}
        {% if results is not empty %}<div class="s-foot">{{ 'entry.search_source'|trans }}</div>{% endif %}
    {% elseif matches is empty %}
        <div class="s-empty">{{ 'entry.no_results'|trans({'%query%': query}) }}</div>
    {% endif %}
</turbo-frame>
