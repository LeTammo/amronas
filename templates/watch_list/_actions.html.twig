{# Trailer, watched toggle and a menu with priority and the rarer actions #}
{% set entry = row.entry %}
{% set return = app.request.requestUri %}
{% set token = csrf_token('entry') %}
{% set prio = entry.priority.value %}

{% if not (compact ?? false) %}
    <a class="round trailer" href="{{ entry.title.trailerSearchUrl }}" target="_blank" rel="noopener" title="{{ 'entry.trailer'|trans }}" aria-label="{{ 'entry.trailer'|trans }}">{{ ux_icon('tabler:player-play') }}</a>
{% endif %}

{% if is_granted('LIST_EDIT', list) %}
    <form method="post" action="{{ path('app_entry_watched', {id: entry.id}) }}" data-turbo-action="replace">
        <input type="hidden" name="_token" value="{{ token }}">
        <input type="hidden" name="return" value="{{ return }}">
        <button class="round {{ entry.watched ? 'done' }}" title="{{ (entry.watched ? 'entry.unwatch' : 'entry.watch')|trans }}" aria-label="{{ (entry.watched ? 'entry.unwatch' : 'entry.watch')|trans }}">{{ ux_icon('tabler:check') }}</button>
    </form>
{% endif %}

<details class="menu">
    <summary class="round" title="{{ 'action.more'|trans }}" aria-label="{{ 'action.more'|trans }}">{{ ux_icon('tabler:dots') }}</summary>
    <div class="menu-items">
        {% if is_granted('LIST_EDIT', list) and not entry.watched %}
            <form method="post" action="{{ path('app_entry_priority', {id: entry.id}) }}" data-turbo-action="replace">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="return" value="{{ return }}">
                <button name="priority" value="{{ prio == 'important' ? 'normal' : 'important' }}" class="{{ prio == 'important' ? 'active' }}">
                    {{ ux_icon('tabler:flame') }}{{ (prio == 'important' ? 'entry.important_undo' : 'entry.important')|trans }}
                </button>
                <button name="priority" value="{{ prio == 'maybe' ? 'normal' : 'maybe' }}" class="{{ prio == 'maybe' ? 'active' }}">
                    {{ ux_icon('tabler:hourglass') }}{{ (prio == 'maybe' ? 'entry.maybe_undo' : 'entry.maybe')|trans }}
                </button>
            </form>
            <hr>
        {% endif %}
        {% if compact ?? false %}
            <a href="{{ entry.title.trailerSearchUrl }}" target="_blank" rel="noopener">{{ ux_icon('tabler:player-play') }}{{ 'entry.trailer'|trans }}</a>
        {% endif %}
        <a href="{{ entry.title.imdbUrl }}" target="_blank" rel="noopener">{{ ux_icon('tabler:external-link') }}{{ 'entry.imdb'|trans }}</a>
        {% if is_granted('LIST_EDIT', list) %}
            <form method="post" action="{{ path('app_entry_refresh', {id: entry.id}) }}" data-turbo-action="replace">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="return" value="{{ return }}">
                <button>{{ ux_icon('tabler:refresh') }}{{ 'entry.refresh'|trans }}</button>
            </form>
        {% endif %}
        {% if is_granted('LIST_EDIT', list) %}
            <form method="post" action="{{ path('app_entry_remove', {id: entry.id}) }}" data-turbo-action="replace" data-turbo-confirm="{{ 'entry.remove_confirm'|trans({'%name%': entry.title.name}) }}">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="return" value="{{ return }}">
                <button class="danger">{{ ux_icon('tabler:trash') }}{{ 'entry.remove'|trans }}</button>
            </form>
        {% endif %}
        {% if entry.watched %}
            <span class="menu-note">{{ 'entry.watched_on'|trans({'%date%': entry.watchedAt|date('d.m.Y')}) }}</span>
        {% endif %}
    </div>
</details>
